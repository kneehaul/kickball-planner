{
  "name": "kickball-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kickball-planner --local",
    "db:migrate:remote": "wrangler d1 migrations apply kickball-planner --remote"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.12.18",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^4.20260509.1",
    "@vitejs/plugin-react": "^1.3.2",
    "drizzle-kit": "^0.31.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.0",
    "wrangler": "^4.83.0"
  }
}
